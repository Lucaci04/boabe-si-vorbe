---
import '../styles/global.css';
import Header from '../components/common/Header.astro';
import Hero from '../components/sections/Hero.astro';
import Story from '../components/sections/Story.astro';
import MenuSection from '../components/sections/MenuSection.astro';
import BookingSection from '../components/sections/BookingSection.astro';
import LocationSection from '../components/sections/LocationSection.astro';
import Footer from '../components/common/Footer.astro';
import { cafe } from '../data/cafe-config';

const title = `${cafe.name} — Cafenea de specialitate & prăjitorie`;
const description =
  'Cafenea de specialitate cu laborator de prăjire artizanală. Cafea de origine prăjită lent, patiserie scandinavă și rezervări online.';
---

<!doctype html>
<html lang="ro">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#d9b98d" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <a
      href="#continut"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:bg-ink focus:px-4 focus:py-2 focus:text-kraft"
    >
      Sari la conținut
    </a>
    <Header />
    <main id="continut">
      <Hero />
      <Story />
      <MenuSection />
      <BookingSection />
      <LocationSection />
    </main>
    <Footer />
  </body>
</html>
